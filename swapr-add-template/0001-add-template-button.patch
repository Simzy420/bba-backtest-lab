+    id,
+    title: slugTitle(file.name),
+    description: "Your clip — available in this browser session.",
+    video_path: "",
+    blob_url: blobUrl,
+    duration_s: duration ?? 4,
+    tags: ["custom"],
+    category: "custom",
+    thumbnail: null,
+    source: "Added on device",
+    custom: true,
